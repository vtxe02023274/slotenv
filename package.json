{
  "name": "slotenv",
  "version": "0.3.1",
  "description": "Run parallel coding agents without collisions: each git worktree gets its own ports, .env, Postgres, MySQL, SQLite or Redis database and Compose project. No containers.",
  "type": "module",
  "bin": {
    "slotenv": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "git-worktree",
    "worktree",
    "parallel-agents",
    "coding-agents",
    "ports",
    "dotenv",
    "dev-server",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzoraemon043/slotenv.git"
  },
  "homepage": "https://github.com/zzoraemon043/slotenv#readme",
  "bugs": "https://github.com/zzoraemon043/slotenv/issues",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
